<script type="module">
import Captcha from '/share/atlantis/js/captcha.js?realboot=true';
</script>

<div id="<?php $Util->Print($ElementID) ?>" class="border border-1 border-secondary rounded-less p-2 nether-captcha">
	<!-- CAPTCHA IMAGE -->
	<div class="mb-2">
