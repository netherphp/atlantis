<style type="text/css">
@keyframes timerwarning {
	100% { background-color: #00CC00; width: 100%; }
	30% { background-color: #00CC00; }
	29% { background-color: #CC6600; }
	0% { background-color: #FF0000; width: 0%; }
}

.nether-captcha { display: inline-block; }
.nether-captcha *[data-vmode="invert"] { filter: invert(); }

.nether-captcha button        { background: #FFFFFF11; border: 1px solid #FFFFFF22; display: block; width: 100%; }
.nether-captcha button.active { background: #FFFFFF44; border: 1px solid #FFFFFF66; }

.nether-captcha .progress     { height: 4px; justify-content: end; }
.nether-captcha .progress-bar {
	--percent: calc(var(--progress-value) * 1%);
	transition: width 1000ms linear;
	width: var(--percent);
}

.nether-captcha:not([data-captcha-status]) .nether-captcha-image { opacity: 0.5; }

.nether-captcha i[data-status="empty"]   { display: none; }
.nether-captcha i[data-status="pending"] { display: none; color: #FFFFFF22; }
.nether-captcha i[data-status="valid"]   { display: none; color: #00AA00; }
.nether-captcha i[data-status="invalid"] { display: none; color: #AA0000; }
.nether-captcha i[data-status="loading"] { display: none; color: #FFFFFFAA; }

.nether-captcha:not([data-captcha-status])     i[data-status="empty"]   { display: inline; }
.nether-captcha[data-captcha-status="pending"] i[data-status="pending"] { display: inline; }
.nether-captcha[data-captcha-status="valid"]   i[data-status="valid"]   { display: inline; }
.nether-captcha[data-captcha-status="invalid"] i[data-status="invalid"] { display: inline; }
.nether-captcha[data-captcha-status="loading"] i[data-status="loading"] { display: inline; }
</style>

<script type="module">
import API from '/share/nui/api/json.js';

class Captcha {

	id = null;

	element = null;
	img =  null;
	token = null;
	code = null;
	btnContrast = null;	

	codeTryTimer = null;
	rateLimitTimer = null;
	
	ttlTimer = null;
	ttlValue = null;
	ttlStart = null;

	////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////

	constructor(elem) {
		
		this.element = jQuery(elem);
		this.id = this.element.attr('id');
		this.img = this.element.find('[data-captcha-image]');
		this.token = this.element.find('[data-captcha-token]');
		this.code = this.element.find('[data-captcha-code]');
		this.btnContrast = this.element.find('[data-captcha-toggle-contrast]');
		this.btnFresh = this.element.find('[data-captcha-fresh]');
		this.pbarLifespan = this.element.find('.progress');

		(this.code)
		.on('keyup', this.onCodeKeyUp.bind(this));

		(this.btnContrast)
		.on('click', this.onToggleContrast.bind(this));

		(this.btnFresh)
		.on('click', this.onFresh.bind(this));

		this.updateStatusPending();
		this.refresh();

		return;
	};

	////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////

	refresh() {

		let that = this;
		let api = new API.Request('FRESH', '/api/captcha');
		let data = { 'Type': 'nether' };

		////////

		that.code.val('');
		that.updateStatusLoading();

		(api.send(data))
		.then(function(r) {
			that.startCountdown(r.payload.TTL - 2);
			that.updateStatusPending();
			that.updateToken(r.payload.Token);
			that.updateImage(r.payload.Image);
			return;
		})
		.catch(function(r) {
			if(r.error === 2) {
				that.updateStatusPending();
				alert(r.message);
				return;
			}

			api.catch(r);
			return;
		});
		
		return;
	};

	////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////

	updateStatusValid() {
		this.element.attr('data-captcha-status', 'valid');
		return;
	};

	updateStatusInvalid() {
		this.element.attr('data-captcha-status', 'invalid');
		return;
	};

	updateStatusPending() {
		this.element.attr('data-captcha-status', 'pending');
		return;
	};

	updateStatusLoading() {
		this.element.attr('data-captcha-status', 'loading');
		return;
	};

	updateImage(src) {

		this.img.attr('src', src);

		return;
	};

	updateToken(token) {

		this.token.val(token);

		return;
	};

	updateProgressTTL(value) {

		(this.pbarLifespan)
		.css('--progress-value', `${value}`);

		return;
	};

	startCountdown(ttl) {

		if(this.ttlTimer)
		clearTimeout(this.ttlTimer);

		////////

		this.ttlValue = ttl;
		this.ttlStart = Math.floor(Date.now() / 1000);

		this.onTimerTTL();

		return this;
	};

	////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////

	onCodeKeyUp(ev) {

		if(this.rateLimitTimer !== null)
		return;

		////////

		this.updateStatusLoading();

		if(this.codeTryTimer !== null)
		clearTimeout(this.codeTryTimer);

		this.codeTryTimer = setTimeout(
			this.onCodeTry.bind(this, [ ev ]),
			750
		);

		return false;
	};

	onCodeTry(ev) {

		let that = this;
		let api = new API.Request('CHECK', '/api/captcha');
		let data = { Type: 'nether' };

		data['nether-captcha-token'] = this.token.val();
		data['nether-captcha-code'] = this.code.val();

		(api.send(data))
		.then(function(r) {
			
			if(r.payload.Valid)
			that.updateStatusValid();
			else
			that.updateStatusInvalid();

			return;
		})
		.catch(function(r) {
			if(r.error === 2) {
				that.onRateLimited(ev);
				console.log(`[onCodeTry] ${r.message}`);
				return;
			}

			api.catch(r);
			return;
		});

		return false;
	}

	onRateLimited(ev) {

		this.rateLimitTimer = setTimeout(
			this.onCodeTry.bind(this, [ ev ]),
			2000
		);

		return false;
	};

	onToggleContrast(ev) {

		let current = this.img.attr('data-vmode');

		if(current) {
			this.img.attr('data-vmode', '');
			this.btnContrast.removeClass('active');
		}
		else {
			this.img.attr('data-vmode', 'invert');
			this.btnContrast.addClass('active');
		}

		return false;
	};

	onFresh(ev) {
	
		this.refresh();

		return false;
	};

	onTimerTTL() {

		let now = Math.floor(Date.now() / 1000);
		let diff = (now - this.ttlStart);
		let value = 100 - ((diff / this.ttlValue) * 100);

		////////

		if(value > 100) value = 100;
		if(value < 0) value = 0;

		this.updateProgressTTL(value);

		////////

		if(value > 0) {
			this.ttlTimer = setTimeout(
				this.onTimerTTL.bind(this),
				1000
			);

			return false;
		}

		this.refresh();

		////////

		return false;
	};

	////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////

	static WhenDocumentReady() {
		// this<document>

		jQuery('.nether-captcha')
		.each(function() {

			if(typeof this.dataset.captchaStatus === 'undefined')
			new Captcha(this);

			return;
		});

		return;
	};

};

jQuery(Captcha.WhenDocumentReady);

</script>

