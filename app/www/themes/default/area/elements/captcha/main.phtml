<style type="text/css">
.ntr-captcha { display: inline-block; }
.ntr-captcha *[data-vmode="invert"] { filter: invert(); }

.ntr-captcha button { background: #FFFFFF11; border: 1px solid #FFFFFF22; display: block; width: 100%; }
.ntr-captcha button.active { background: #FFFFFF44; border: 1px solid #FFFFFF66; }

.ntr-captcha i[data-status="empty"]   { display: none; }
.ntr-captcha i[data-status="pending"] { display: none; color: #FFFFFF22; }
.ntr-captcha i[data-status="valid"]   { display: none; color: #00AA00; }
.ntr-captcha i[data-status="invalid"] { display: none; color: #AA0000; }
.ntr-captcha i[data-status="loading"] { display: none; color: #FFFFFFAA; }

.ntr-captcha:not([data-captcha-status])     i[data-status="empty"]   { display: inline; }
.ntr-captcha[data-captcha-status="pending"] i[data-status="pending"] { display: inline; }
.ntr-captcha[data-captcha-status="valid"]   i[data-status="valid"]   { display: inline; }
.ntr-captcha[data-captcha-status="invalid"] i[data-status="invalid"] { display: inline; }
.ntr-captcha[data-captcha-status="loading"] i[data-status="loading"] { display: inline; }
</style>

<script type="module">
import API from '/share/nui/api/json.js';

class Captcha {

	id = null;

	element = null;
	img =  null;
	token = null;
	code = null;
	btnContrast = null;	

	codeTryTimer = null;
	rateLimitTimer = null;

	////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////

	constructor(elem) {
		
		this.element = jQuery(elem);
		this.id = this.element.attr('id');
		this.img = this.element.find('[data-captcha-image]');
		this.token = this.element.find('[data-captcha-token]');
		this.code = this.element.find('[data-captcha-code]');
		this.btnContrast = this.element.find('[data-captcha-toggle-contrast]');
		this.btnFresh = this.element.find('[data-captcha-fresh]');

		(this.code)
		.on('keyup', this.onCodeKeyUp.bind(this));

		(this.btnContrast)
		.on('click', this.onToggleContrast.bind(this));

		(this.btnFresh)
		.on('click', this.onFresh.bind(this));

		this.updateStatusPending();

		return;
	};

	////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////

	updateStatusValid() {
		this.element.attr('data-captcha-status', 'valid');
		return;
	};

	updateStatusInvalid() {
		this.element.attr('data-captcha-status', 'invalid');
		return;
	};

	updateStatusPending() {
		this.element.attr('data-captcha-status', 'pending');
		return;
	};

	updateStatusLoading() {
		this.element.attr('data-captcha-status', 'loading');
		return;
	};

	////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////

	onCodeKeyUp(ev) {

		if(this.rateLimitTimer !== null)
		return;

		////////

		this.updateStatusLoading();

		if(this.codeTryTimer !== null)
		clearTimeout(this.codeTryTimer);

		this.codeTryTimer = setTimeout(
			this.onCodeTry.bind(this, [ ev ]),
			750
		);

		return false;
	};

	onCodeTry(ev) {

		let that = this;
		let api = new API.Request('CHECK', '/api/captcha');
		let data = { Type: 'nether' };

		data['nether-captcha-token'] = this.token.val();
		data['nether-captcha-code'] = this.code.val();

		(api.send(data))
		.then(function(r) {
			
			if(r.payload.Valid)
			that.updateStatusValid();
			else
			that.updateStatusInvalid();

			return;
		})
		.catch(function(r) {
			if(r.error === 2) {
				that.onRateLimited(ev);
				console.log(`[onCodeTry] ${r.message}`);
				return;
			}

			api.catch(r);
			return;
		});

		return false;
	}

	onRateLimited(ev) {

		this.rateLimitTimer = setTimeout(
			this.onCodeTry.bind(this, [ ev ]),
			2000
		);

		return false;
	};

	onToggleContrast(ev) {

		let current = this.img.attr('data-vmode');

		if(current) {
			this.img.attr('data-vmode', '');
			this.btnContrast.removeClass('active');
		}
		else {
			this.img.attr('data-vmode', 'invert');
			this.btnContrast.addClass('active');
		}

		return false;
	};

	onFresh(ev) {
	
		let that = this;
		let api = new API.Request('FRESH', '/api/captcha');
		let data = { 'Type': 'nether' };

		that.code.val('');
		that.updateStatusLoading();

		(api.send(data))
		.then(function(r) {

			that.updateStatusPending();
			that.token.val(r.payload.Token);
			that.img.attr('src', r.payload.Image);

			return;
		})
		.catch(function(r) {
			if(r.error === 2) {
				that.updateStatusPending();
				console.log(`[onFresh] ${r.message}`);
				alert(r.message);
				return;
			}

			api.catch(r);
			return;
		});

		return false;
	};

	////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////

	static WhenDocumentReady() {
		// this<document>

		jQuery('.ntr-captcha')
		.each(function() {

			if(typeof this.dataset.captchaStatus === 'undefined')
			new Captcha(this);

			return;
		});

		return;
	};

};

jQuery(Captcha.WhenDocumentReady);

</script>

