	<div class="d-flex w-100 gap-2 mb-2">
		<div class="flex-shrink-1 flex-grow-1">
			<button type="button" title="Toggle Contrast Mode" data-captcha-toggle-contrast>
				<i class="mdi mdi-contrast-box"></i>
			</button>
		</div>
		<div class="flex-shrink-1 flex-grow-1">
