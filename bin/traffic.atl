<?php

use Nether\Atlantis;
use Nether\Common;
use Nether\Console;
use Nether\Storage;
use Nether\User;

(function(){
	require(sprintf('%s/autoload.php', dirname(__DIR__, 3)));
	return;
})();

////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////

class TrafficReport1
extends Common\Prototype {

	public string
	$ReportStart;

	public string
	$ReportStop;

	public string
	$Domain;

	public int
	$TrafficTotal;

	public int
	$VisitorUnique;

	public float
	$VisitorAveragePageView;

	public function
	ToArray():
	array {

		$Data = [
			$this->ReportStart,
			$this->ReportStop,
			$this->Domain,
			$this->TrafficTotal,
			$this->VisitorUnique,
			$this->VisitorAveragePageView
		];

		return $Data;
	}

	public function
	ToArrayHuman():
	array {

		$Data = [
			$this->ReportStart,
			$this->ReportStop,
			$this->Domain,
			number_format($this->TrafficTotal),
			number_format($this->VisitorUnique),
			number_format($this->VisitorAveragePageView)
		];

		return $Data;
	}

	public function
	ToHeaders():
	array {

		$Data = [
			'ReportStart', 'ReportStop', 'Domain',
			'TrafficTotal', 'VisitorUnique', 'VisitorAveragePageView'
		];

		return $Data;
	}

	public function
	ToData():
	array {

		return array_combine($this->ToHeaders(), $this->ToArray());
	}

	public function
	ToCSV():
	string {

		$Data = $this->ToArray();

		return join(',', $Data);
	}

};

////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////

class TrafficTool
extends Atlantis\TerminalApp {

	const
	AppName    = 'Nether Atlantis Traffic Tools',
	AppDesc    = 'Mostly cheat tools for working on the framework.',
	AppVersion = '5.0.0-dev',
	AppDebug   = TRUE;

	////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////

	#[Console\Meta\Command('get')]
	#[Console\Meta\Value('--tz', 'Default: UTC')]
	#[Console\Meta\Value('--date', 'Format: YYYY-MM-DD')]
	#[Console\Meta\Value('--dstart', 'Format: YYYY-MM-DD')]
	#[Console\Meta\Value('--dstop', 'Format: YYYY-MM-DD')]
	public function
	HandleGetStats():
	int {

		$QString = $this->GetOption('qstring');
		$DateZone = $this->GetOption('tz') ?? 'UTC';
		$DateSingle = $this->GetOption('date') ?? date('Y-m-d');
		$DateStart = $this->GetOption('dstart');
		$DateStop = $this->GetOption('dstop');

		if($DateSingle) {
			$DateStart = $DateSingle;
			$DateStop = $DateSingle;
		}

		////////

		$Timeframe = match(TRUE) {
			($DateStart && $DateStop)
			=> new Common\Units\Timeframe(
				Start: sprintf('%s 00:00:00 %s', $DateStart, $DateZone),
				Stop: sprintf('%s 23:59:59 %s', $DateStart, $DateZone)
			),

			default
			=> Common\Units\Timeframe::Today($DateZone)
		};

		////////

		$Results = Atlantis\Struct\TrafficRow::Find([
			'Timeframe' => $Timeframe,
			'QString'     => $QString
		]);

		$this->PrintBulletList([
			'Date Start'    => $Timeframe->GetStartFormat(Common\Values::DateFormatYMDT24VO),
			'Date Stop'     => $Timeframe->GetStopFormat(Common\Values::DateFormatYMDT24VO),
			'QString'       => $QString ?? '',
			'Total Traffic' => (int)$Results->Count()
		]);

		return 0;
	}

	////////////////////////////////////////////////////////////////
	////////////////////////////////////////////////////////////////

	#[Console\Meta\Command('trim')]
	#[Console\Meta\Toggle('--commit', 'Without this nothing bad can happen.')]
	#[Console\Meta\Value('--limit', 'Delete the rows in chunks of <limit> rows to be nice to the server.')]
	#[Console\Meta\Toggle('--1m', 'Delete rows older than 1 month.')]
	#[Console\Meta\Toggle('--2m', 'Delete rows older than 2 months.')]
	#[Console\Meta\Toggle('--3m', 'Delete rows older than 3 months (and the default).')]
	#[Console\Meta\Toggle('--6m', 'Delete rows older than 6 months.')]
	public function
	HandleTrim():
	int {

		$OptCommit = $this->GetOption('commit') ?? FALSE;
		$OptLimit = (int)$this->GetOption('limit');

		$OptTimeThen = match(TRUE) {
			($this->GetOption('1m'))
			=> '-30 days',

			($this->GetOption('2m'))
			=> '-60 days',

			($this->GetOption('3m'))
			=> '-90 days',

			($this->GetOption('6m'))
			=> '-180 days',

			default
			=> '-90 days'
		};

		$Timer = new Common\Timer;
		$Now = new Common\Date(Immutable: TRUE);
		$Then = $Now->Modify($OptTimeThen);
		$QueryFind = $this->App->Database->NewVerse(Atlantis\Struct\TrafficRow::$DBA);
		$QueryTrim = $this->App->Database->NewVerse(Atlantis\Struct\TrafficRow::$DBA);
		$Table = Atlantis\Struct\TrafficRow::GetTableInfo();
		$Args = NULL;
		$Found = NULL;
		$Trimmed = NULL;

		////////

		$QueryFind->Select($Table->GetAliasedTable());
		$QueryFind->Fields('*');
		$QueryFind->Where(sprintf(
			'%s <= :ThenTime',
			$Table->GetAliasedField('TimeCreated')
		));

		$QueryTrim->Delete($Table->Name);
		$QueryTrim->Where(sprintf(
			'TimeCreated <= :ThenTime'
		));

		if($OptLimit > 0) {
			//$QueryFind->Limit($OptLimit);
			$QueryTrim->Limit($OptLimit);
		}

		$Args = [
			':ThenTime' => $Then->GetUnixtime()
		];

		////////

		$this->PrintBulletList([
			'Now'       => $Now->Get(),
			'Then'      => $Then->Get(),
			'QueryFind' => (string)$QueryFind,
			'QueryTrim' => (string)$QueryTrim
		]);

		$Timer->Reset()->Start();
		$Found = $QueryFind->Query($Args);
		$Timer->Stop();

		$this->PrintStatus(sprintf(
			'Found %s rows in %s...',
			number_format($Found->GetCount()),
			(new Common\Units\Timeframe(
				Start: 0, Stop: $Timer->Get() + 1
			))->Get(Common\Units\Timeframe::FormatLong)
		));

		if($OptCommit) {
			HitIt:
			$Timer->Reset()->Start();
			$Trimmed = $QueryTrim->Query($Args);
			$Timer->Stop();

			$this->PrintStatus(sprintf(
				'Trimmed %s rows in %s...',
				number_format($Trimmed->GetCount()),
				(new Common\Units\Timeframe(
					Start: 0, Stop: $Timer->Get() + 1
				))->Get(Common\Units\Timeframe::FormatLong)
			));

			if($Trimmed->GetCount() === $OptLimit)
			goto HitIt;
		}

		return 0;
	}

	#[Console\Meta\Command('report1')]
	public function
	HandleReportV1():
	int {

		// very rough draft implementation of the query i been manually running
		// in my sql client for years.

		$Format = 'human';

		if($this->GetOption('csv'))
		$Format = 'csv';

		////////

		if($this->GetOption('month')) {
			if(!preg_match('/^\d{4}-\d{2}$/', $this->GetOption('month')))
			throw new Common\Error\FormatInvalid('--month=YYYY-MM');

			$Today = Common\Date::FromDateString(sprintf('%s-01', $this->GetOption('month')));
		} else {
			$Today = Common\Date::FromDateString('now');
		}

		$CurrentYear = $Today->Get('Y');
		$CurrentMonth = $Today->Get('m');
		$CurrentMonthEnd = $Today->Get('t');

		$DateStart = sprintf(
			'%s-%s-01 00:00:00',
			$CurrentYear,
			$CurrentMonth
		);

		$DateStop = sprintf(
			'%s-%s-%s 23:59:59',
			$CurrentYear,
			$CurrentMonth,
			$CurrentMonthEnd
		);

		$DB = $this->App->Database->Get('Default');
		$Result = NULL;
		$Query = NULL;
		$Row = NULL;
		$Data = new Common\Datastore;

		////////

		$DB->Query("BEGIN TRANSACTION;");
		$DB->Query("SET @TimeStart = UNIX_TIMESTAMP('{$DateStart}');");
		$DB->Query("SET @TimeStop  = UNIX_TIMESTAMP('{$DateStop}');");

		$Query = "
			SELECT
				FROM_UNIXTIME(@TimeStart) AS ReportStart,
				FROM_UNIXTIME(@TimeStop) AS ReportStop,
				TrafficTotal.Domain AS Domain,
				TrafficTotal.Hits AS TrafficTotal,
				UniqueVisitors.Hits AS VisitorUnique,
				(TrafficTotal.Hits / UniqueVisitors.Hits) AS VisitorAveragePageView

			FROM
				(SELECT Domain, COUNT(*) AS Hits
				FROM TrafficRows WHERE (TimeCreated >= @TimeStart AND TimeCreated < @TimeStop)
				GROUP BY Domain) TrafficTotal

			LEFT JOIN
				(SELECT Domain, COUNT(*) AS Hits FROM (
					SELECT Visitor, Domain, COUNT(*) AS Visits
					FROM TrafficRows
					WHERE (TimeCreated >= @TimeStart AND TimeCreated < @TimeStop)
					GROUP BY Visitor, Domain
				) Q1 GROUP BY Q1.Domain) UniqueVisitors
			ON
				TrafficTotal.Domain=UniqueVisitors.Domain

			ORDER BY Domain;
		";

		$DB->Query($Query);
		$DB->Query('COMMIT TRANSACTION');

		$Result = $DB->Query($Query);

		while($Row = $Result->Next()) {
			$Data->Push(new TrafficReport1($Row));
			continue;
		}

		if(!$Data->Count()) {
			$this->PrintStatusWarning(sprintf('No data for %s to %s', $DateStart, $DateStop));
			return 0;
		}

		if($Format === 'csv') {
			echo join(',', $Data[0]->ToHeaders()), PHP_EOL;
			
			$Data->Each(
				fn($D)=> printf('%s%s', $D->ToCSV(), PHP_EOL)
			);
		}

		else
		Console\Elements\Table::New(
			Client: $this,
			Headers: $Data[0]->ToHeaders(),
			Rows: $Data->Map(fn($D)=> $D->ToArrayHuman()),
			Print: 2
		);

		return 0;
	}

}

exit((new TrafficTool)->Run());
